# ===========================================
# CONFIGURARE BAZA DE DATE
# ===========================================
# PostgreSQL local. Înlocuiește utilizatorul, parola și numele bazei cu ale tale.
DATABASE_URL="postgresql://postgres:parola_ta@localhost:5432/robotics_blog?schema=public"

# Pentru deploy pe Vercel folosește un Neon DB (gratis):
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"

# ===========================================
# NEXTAUTH (autentificare)
# ===========================================
# Generează un secret aleatoriu de min. 32 caractere.
# Poți rula în terminal: openssl rand -base64 32
NEXTAUTH_SECRET="schimba_acest_secret_cu_unul_aleatoriu_de_minim_32_caractere"

# URL-ul aplicației. Local rămâne așa, în producție va fi domeniul Vercel.
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# SECURITATE - Rate limiting și 2FA
# ===========================================
# Numărul maxim de tentative eșuate de login înainte de blocare temporară
MAX_LOGIN_ATTEMPTS="5"

# Durata blocării (în minute)
LOCKOUT_DURATION_MINUTES="15"

# Numele aplicației pentru aplicațiile de autentificare 2FA (Google Authenticator etc.)
TWO_FA_APP_NAME="Blog Robotică"

# ===========================================
# UPLOAD FIȘIERE
# ===========================================
# Dimensiunea maximă acceptată (în MB) pentru fișiere normale
MAX_UPLOAD_SIZE_MB="10"

# Limita separată pentru video — mai mare pentru demonstrații
MAX_VIDEO_SIZE_MB="50"

# ===========================================
# EMAIL — Resend (pentru reset parolă, notificări)
# ===========================================
# Înregistrare gratuită: https://resend.com (3000 email/lună gratis)
# Generează API key din Dashboard → API Keys.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Adresa "From". Pentru testare poți folosi onboarding@resend.dev (subdomeniul
# verificat al Resend, dar trimite doar către adresa cu care te-ai înregistrat).
# Pentru producție configurează un domeniu propriu în Resend.
EMAIL_FROM="RoboLab <onboarding@resend.dev>"
